# UFDR Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Model Configuration (Required)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-2.5-flash

# =============================================================================
# Database Configuration (Required)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/ufdr_agent

# =============================================================================
# Redis Configuration (Required for chat sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Object Storage Configuration (Required for UFDR uploads)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ufdr-uploads
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# =============================================================================
# Application Configuration (Optional)
# =============================================================================
# Comma-separated list of allowed CORS origins
# Example: http://localhost:3000,https://yourapp.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting: requests per minute per IP
RATE_LIMIT_PER_MINUTE=100

# Database connection pool size
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=25

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
